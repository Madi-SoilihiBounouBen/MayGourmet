<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Plats</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/plat.css">
</head>
<body>

<%- include('navbar') -%>

<h1 id="titrePlat">Liste des plats</h1>

<button id="myBtnPlat">Ajouter plat</button>

<div class="cards-container-plat">
    <% resultats.forEach(plat => { %>

        <div class="cards-plat"> 
            
            <% if (plat.image) { %>
                <img src="/image/<%= plat.image %>" alt="<%= plat.nom_plat %>" class="plat-image" height="120px" width="120px">
            <% } else { %>
                <img id="imagePouletCurry" src="/image/PouletCurryLaitCoco.png" alt="Poulet Curry Lait Coco" class="plat-image" height="120px" width="120px">
            <% } %>
        
            <h4>
                <%= plat.nom_plat %>
            </h4>
            <p><%= plat.prix %>€</p>
            <p><%= plat.categorie %></p>

            <div class="texte-cache">
                <h2><%= plat.nom_plat %></h2>
                <p>
                    <% if (plat.presentation) { %>
                        <%= plat.presentation %>
                    <% } else { %>
                        Découvrez ce délicieux plat.
                    <% } %>
                </p>
            </div>

        </div>
    <% }) %>
    
</div>

</body>
</html>