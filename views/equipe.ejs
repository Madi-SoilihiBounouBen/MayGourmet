<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipe</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/modal.css">
    <link rel="stylesheet" href="/css/toast.css">
    <script src="/js/scripte.js" defer></script>
</head>
<body class="equipe">
    <!-- Inclure le fichier navbar.ejs pour avoir la barre de navigation -->
     <%- include('navbar') -%>
    <h2>Mon équipe May Gourmet</h2>
    <!-- Bouton pour ouvrir le modal -->
    <button id="myBtn">Ajouter un membre</button>
    <div class="cards-container">
      <% resultatEquipe.forEach(resultat => { %>
          <div class="card">
            <img class="team" id="bonbon" src="/image/egor-litvinov-fPaqcD2veYo-unsplash.jpg" alt="">
            <div class="container">
              <h4><b><%= resultat.nom %> <%= resultat.prenom %></b></h4>
              <p><%= resultat.poste %></p>
              <input type="button" value="supprimer" onclick="demanderConfirmation('<%= resultat.id %>')">
            </div>
          </div>
        <%}); %>
      </div>

    <!-- Modal de confirmation suppression -->
    <div id="confirmModal" class="modal">
      <div class="modal-content">
        <div class="modal-header">
          <h2>Confirmation</h2>
        </div>
        <div class="modal-body">
          <p>Voulez-vous vraiment supprimer ce membre ?</p>
        </div>
        <div class="modal-footer">
          <button id="confirmDelete">Oui</button>
          <button id="cancelDelete">Non</button>
        </div>
      </div>
    </div>

    <!-- Toast notification -->
    <div id="toast" class="toast">Suppression réussie !</div>



      <!-- Modal -->
      <div id="myModal" class="modal">
        <div class="modal-content">
        <div class="modal-header">
          <h2>Ajouter un membre</h2>
          <span class="close">&times;</span>
        </div>
        <div class="modal-body">
          <p>Je suis body</p>
          <p>Formulaire d'inscription</p>

            <div class="container">
                <form action="/api/equipe" method="post">
                    <!-- Ligne 1 du formulaire-->
                     <div class="row">
                        <div class="col-25">
                            <label for="nom">Nom :</label>
                        </div>

                        <div class="col-75">
                            <input type="text" name="nom" id="nom">
                        </div>
                     </div>

                     <!-- Ligne 2 du formulaire-->
                     <div class="row">
                      <div class="col-25">
                        <label for="prenom">Prénom :</label>
                      </div>
                      <div class="col-75">
                        <input type="text" name="prenom" id="prenom">
                      </div>
                     </div>

                     <!-- Ligne 3 du formulaire-->
                     <div class="row">
                      <div class="col-25">
                        <label for="mail">Mail :</label>
                      </div>
                      <div class="col-75">
                        <input type="email" name="mail" id="mail">
                      </div>
                     </div>

                     <!-- Ligne 4 du formulaire-->
                     <div class="row">
                      <div class="col-25">
                        <label for="telephone">Téléphone :</label>
                      </div>
                      <div class="col-75">
                        <input type="tel" name="telephone" id="telephone">
                      </div>
                     </div>

                     <!-- Ligne 5 du formulaire-->
                     <div class="row">
                      <div class="col-25">
                        <label for="poste">Poste :</label>
                      </div>
                      <div class="col-75">
                        <input type="text" name="poste" id="poste">
                      </div>
                     </div>

                     <!-- Ligne 6 du formulaire-->
                     <div class="row">
                      <div class="col-25">
                        <label for="adresse">Adresse postale :</label>
                      </div>
                      <div class="col-75">
                        <input type="text" name="adresse" id="adresse">
                      </div>
                     </div>

                     <!-- Ligne 7 du formulaire-->
                     <div class="row">
                      <div class="col-25">
                        <label for="presentation">Présentation :</label>
                      </div>
                      <div class="col-75">
                        <textarea name="presentation" id="presentation" rows="3" style="width:100%;"></textarea>
                      </div>
                     </div>

                     <!-- Ligne 8 du formulaire-->
                     <div class="row">
                      <div class="col-25">
                        <label for="dateRecrutement">Date de recrutement :</label>
                      </div>
                      <div class="col-75">
                        <input type="date" name="dateRecrutement" id="dateRecrutement">
                      </div>
                     </div>
                     <div class="row">
                       <div class="col-75" style="text-align:right; margin-top:16px;">
                         <button type="submit" id="btnEnregistrer">Enregistrer</button>
                       </div>
                     </div>
                </form>
            </div>
        </div>
        </div>
      </div>
</body>

<script>
// Modal ajout membre
var modal = document.getElementById("myModal");
var btn = document.getElementById("myBtn");
var span = document.getElementsByClassName("close")[0];
btn.onclick = function() { modal.style.display = "block"; }
span.onclick = function() { modal.style.display = "none"; }
window.onclick = function(event) {
  if (event.target == modal) { modal.style.display = "none"; }
  if (event.target == confirmModal) { confirmModal.style.display = "none"; }
}

// Modal confirmation suppression
var confirmModal = document.getElementById("confirmModal");
var confirmDeleteBtn = document.getElementById("confirmDelete");
var cancelDeleteBtn = document.getElementById("cancelDelete");
var idToDelete = null;

function demanderConfirmation(id) {
  idToDelete = id;
  confirmModal.style.display = "block";
}
cancelDeleteBtn.onclick = function() {
  confirmModal.style.display = "none";
  idToDelete = null;
}
confirmDeleteBtn.onclick = function() {
  if (idToDelete) {
    supprimer(idToDelete);
    confirmModal.style.display = "none";
    idToDelete = null;
  }
}

// Toast
function showToast(message) {
  var toast = document.getElementById("toast");
  toast.textContent = message;
  toast.className = "toast show";
  setTimeout(function(){ toast.className = toast.className.replace("show", ""); }, 3000);
}
</script>



</html>