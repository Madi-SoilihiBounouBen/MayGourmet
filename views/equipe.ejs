<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Equipe</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Inclure le fichier navbar.ejs pour avoir la barre de navigation -->
     <%- include('navbar') -%>
    <h2>Mon équipe May Gourmet</h2>
    
    <% resultatEquipe.forEach(resultat => { %>
        <div class="card">
            <img class="team" src="/image/egor-litvinov-fPaqcD2veYo-unsplash.jpg" alt="">
            <div class="container">
                <h4><b><%= resultat.nom %> <%= resultat.prenom %></b></h4>
                <p><%= resultat.poste %></p>
                <input type="button" value="supprimer" onclick="supprimer('<%= resultat.id %>')">
            </div>
        </div>
        
    <%}); %>
</body>

<script>

</script>
</html>